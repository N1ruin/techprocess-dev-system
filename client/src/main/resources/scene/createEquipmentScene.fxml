<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="500.0" prefWidth="650.0"
            style="-fx-background-color: #F4F7F9;"
            stylesheets="@css/style.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="by.niruin.techprocessSystem.domain.controller.CreateEquipmentController">
   <center>
      <VBox alignment="CENTER" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="TOP_CENTER" maxWidth="500.0" spacing="20.0"
                  style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40;">
               <children>
                  <Label text="Новая оснастка" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>

                  <VBox spacing="8.0">
                     <children>
                        <Label text="Индекс оборудования" textFill="#7f8c8d">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="indexField" prefHeight="45.0" promptText="Например: 1234-1234"
                                   style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>

                  <VBox spacing="8.0">
                     <children>
                        <Label text="Примечание" textFill="#7f8c8d">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <TextArea fx:id="noteArea" prefHeight="100.0" promptText="Введите описание..."
                                  wrapText="true" style="-fx-control-inner-background: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </TextArea>
                     </children>
                  </VBox>

                  <VBox spacing="10.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <Button fx:id="imageFindButton" mnemonicParsing="false" onAction="#findImage"
                                      prefHeight="35.0" prefWidth="150.0"
                                      style="-fx-background-color: #ECF0F1; -fx-text-fill: #2C3E50; -fx-background-radius: 8; -fx-cursor: hand;"
                                      text="Выбрать эскиз">
                                 <font>
                                    <Font name="System Bold" size="13.0" />
                                 </font>
                              </Button>
                              <Label fx:id="imagePathLabel" text="Файл не выбран" textFill="#bdc3c7" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <Button fx:id="createButton" mnemonicParsing="false" onAction="#createEquipment"
                          prefHeight="50.0" prefWidth="220.0"
                          style="-fx-background-color: #3498DB; -fx-background-radius: 25; -fx-cursor: hand;"
                          text="СОЗДАТЬ" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                     <effect>
                        <DropShadow height="20.0" radius="9.5" width="20.0">
                           <color>
                              <Color red="0.20392157137393951" green="0.5960784554481506" blue="0.8588235378265381" opacity="0.3" />
                           </color>
                        </DropShadow>
                     </effect>
                  </Button>
               </children>
               <effect>
                  <DropShadow blurType="GAUSSIAN" height="30.0" radius="14.5" width="30.0">
                     <color>
                        <Color red="0.0" green="0.0" blue="0.0" opacity="0.08" />
                     </color>
                  </DropShadow>
               </effect>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>