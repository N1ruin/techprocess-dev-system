<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="600.0" style="-fx-background-color: #F0F8FF;" stylesheets="@css/style.css" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="by.niruin.techprocessSystem.domain.controller.AuthenticationController">
