<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="1200.0" spacing="25.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="by.niruin.techprocessSystem.domain.controller.TechprocessListController">

   <children>
      <VBox spacing="5.0">
         <children>
            <Label text="Техпроцессы системы" textFill="#2C3E50">
               <font>
                  <Font name="System Bold" size="32.0" />
               </font>
            </Label>
            <Label text="Реестр разработок согласно ЕСТД" textFill="#7F8C8D">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #F0F0F0; -fx-border-radius: 15;">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label style="-fx-font-size: 11; -fx-font-weight: bold;" text="Изделие / Обозначение" textFill="#95A5A6" />
                  <TextField fx:id="searchField" prefHeight="40.0" prefWidth="280.0" promptText="Поиск..." style="-fx-background-color: #F8F9FA; -fx-border-color: #E0E0E0; -fx-background-radius: 8; -fx-border-radius: 8;" />
               </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label style="-fx-font-size: 11; -fx-font-weight: bold;" text="Разработчик" textFill="#95A5A6" />
                  <TextField fx:id="developerSearchField" prefHeight="40.0" prefWidth="200.0" promptText="Фамилия..." style="-fx-background-color: #F8F9FA; -fx-border-color: #E0E0E0; -fx-background-radius: 8; -fx-border-radius: 8;" />
               </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label style="-fx-font-size: 11; -fx-font-weight: bold;" text="Основание" textFill="#95A5A6" />
                  <TextField fx:id="baseSearchField" prefHeight="40.0" prefWidth="200.0" promptText="Документ..." style="-fx-background-color: #F8F9FA; -fx-border-color: #E0E0E0; -fx-background-radius: 8; -fx-border-radius: 8;" />
               </children>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="12.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button fx:id="updateTechprocessButton" mnemonicParsing="false" onAction="#updateTechprocess" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #3498DB; -fx-background-radius: 10; -fx-cursor: hand;" text="РЕДАКТИРОВАТЬ" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
                  <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#refreshTable" prefHeight="45.0" prefWidth="50.0" style="-fx-background-color: #ECF0F1; -fx-background-radius: 10; -fx-cursor: hand;" text="🔄" textFill="#2C3E50">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
         <effect>
            <DropShadow blurType="GAUSSIAN" height="20.0" radius="9.5" width="20.0">
               <color>
                  <Color opacity="0.05" />
               </color>
            </DropShadow>
         </effect>
      </HBox>

      <TableView fx:id="techprocessTable" prefHeight="450.0" prefWidth="1140.0" style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #F0F0F0; -fx-selection-bar: #EBF5FB;" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colInventoryNumber" prefWidth="100.0" text="Номер" />
            <TableColumn fx:id="colPartNumber" prefWidth="130.0" text="Обозначение" />
            <TableColumn fx:id="colPartName" prefWidth="200.0" text="Наименование изделия" />
            <TableColumn fx:id="colBase" prefWidth="160.0" text="Основание" />
            <TableColumn fx:id="colTechprocessType" prefWidth="90.0" text="Тип" />
            <TableColumn fx:id="colWorkType" prefWidth="110.0" text="Вид ТП" />
            <TableColumn fx:id="colDeveloper" prefWidth="130.0" text="Разработчик" />
            <TableColumn fx:id="colCreatingDate" prefWidth="120.0" text="Дата создания" />
            <TableColumn fx:id="colStatus" prefWidth="100.0" text="Статус" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
