<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #F4F7F9;"
            stylesheets="@css/style.css"
            xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
            fx:id = "contentArea"
            fx:controller="by.niruin.techprocessSystem.domain.controller.MainController">

   <left>
      <VBox prefHeight="600.0" prefWidth="100.0" spacing="25.0" style="-fx-background-color: #2C3E50;">
         <children>
            <Button fx:id="createNewTechprocessButton" mnemonicParsing="false" prefHeight="70.0" prefWidth="70.0"
                    style="-fx-background-color: #34495E; -fx-background-radius: 15; -fx-cursor: hand;">
               <graphic>
                  <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@image/createProcessMenu.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>

            <Button fx:id="technologicalToolsButton" mnemonicParsing="false" onAction="#openToolsMenu"
                    prefHeight="70.0" prefWidth="70.0"
                    style="-fx-background-color: #34495E; -fx-background-radius: 15; -fx-cursor: hand;">
               <graphic>
                  <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@image/toolsMenuButton.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>

            <VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="logOutButton" mnemonicParsing="false" onAction="#logOut"
                          prefHeight="70.0" prefWidth="70.0"
                          style="-fx-background-color: transparent; -fx-cursor: hand;">
                     <graphic>
                        <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true" opacity="0.6">
                           <image>
                              <Image url="@image/goBackImage.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="20.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets top="30.0" left="15.0" right="15.0" />
         </padding>
      </VBox>
   </left>
</BorderPane>