<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="750.0" prefWidth="600.0"
            style="-fx-background-color: #F0F8FF;"
            stylesheets="@css/style.css"
            xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
            fx:controller="by.niruin.techprocessSystem.domain.controller.RegistrationController">
   <children>
      <ImageView pickOnBounds="true" preserveRatio="false"
                 AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                 AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <image>
            <Image url="@image/startSceneImage.png" />
         </image>
      </ImageView>

      <VBox alignment="CENTER" spacing="20.0"
            style="-fx-background-color: rgba(255, 255, 255, 0.92);"
            AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label text="РЕГИСТРАЦИЯ" textFill="#2C3E50">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
                  <Label text="Введите данные нового сотрудника" textFill="#7F8C8D">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </VBox>

            <VBox alignment="CENTER" spacing="15.0" maxWidth="420.0">
               <children>
                  <TextField fx:id="login" prefHeight="55.0" promptText="Логин" styleClass="modern-input"
                             style="-fx-font-size: 18px; -fx-background-radius: 30; -fx-border-radius: 30;" />

                  <StackPane alignment="CENTER_RIGHT">
                     <children>
                        <PasswordField fx:id="password" prefHeight="55.0" promptText="Пароль" styleClass="modern-input"
                                       style="-fx-font-size: 18px; -fx-background-radius: 30; -fx-border-radius: 30;" />
                        <TextField fx:id="passwordTextField" prefHeight="55.0" promptText="Пароль" styleClass="modern-input" visible="false"
                                   style="-fx-font-size: 18px; -fx-background-radius: 30; -fx-border-radius: 30;" />
                        <Button fx:id="eye" mnemonicParsing="false" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand;">
                           <graphic>
                              <ImageView fx:id="eyeIcon" fitHeight="24.0" fitWidth="24.0" opacity="0.5">
                                 <image>
                                    <Image url="@image/passwordButton.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                           <StackPane.margin>
                              <Insets right="15.0" />
                           </StackPane.margin>
                        </Button>
                     </children>
                  </StackPane>

                  <TextField fx:id="lastName" prefHeight="55.0" promptText="Фамилия" styleClass="modern-input"
                             style="-fx-font-size: 18px; -fx-background-radius: 30; -fx-border-radius: 30;" />
                  <TextField fx:id="firstName" prefHeight="55.0" promptText="Имя" styleClass="modern-input"
                             style="-fx-font-size: 18px; -fx-background-radius: 30; -fx-border-radius: 30;" />
                  <TextField fx:id="surname" prefHeight="55.0" promptText="Отчество" styleClass="modern-input"
                             style="-fx-font-size: 18px; -fx-background-radius: 30; -fx-border-radius: 30;" />

                  <DatePicker fx:id="birthDate" prefHeight="55.0" prefWidth="420.0"
                              promptText="Дата рождения" styleClass="modern-datepicker" />
               </children>
            </VBox>

            <VBox alignment="CENTER" spacing="12.0" maxWidth="420.0">
               <children>
                  <Button fx:id="signUpButton" mnemonicParsing="false" onAction="#signUp"
                          prefHeight="55.0" prefWidth="420.0"
                          style="-fx-background-color: #3498DB; -fx-background-radius: 30; -fx-cursor: hand;"
                          text="ПОДТВЕРДИТЬ" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Button>
                  <Button fx:id="goBackButton" mnemonicParsing="false" onAction="#goBack"
                          prefHeight="40.0" prefWidth="420.0"
                          style="-fx-background-color: transparent; -fx-text-fill: #7F8C8D; -fx-cursor: hand;"
                          text="Вернуться назад">
                     <font>
                        <Font size="15.0" />
                     </font>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </VBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
      </VBox>

      <Label text="Development by N1ruin" textFill="WHITE" opacity="0.8"
             AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0">
         <font>
            <Font size="12.0" />
         </font>
      </Label>
   </children>
</AnchorPane>